# ─── Sanity CMS ────────────────────────────────────────────────────────────
# Get these from sanity.io/manage after creating your project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only token with write access. Used by the seed script.
# sanity.io/manage → API → Tokens → Add API token (Editor role).
# Do NOT prefix with NEXT_PUBLIC_ — it must stay server-side.
SANITY_API_WRITE_TOKEN=

# Same value as the "Secret" field on the Sanity webhook that hits
# POST /api/revalidate. sanity.io/manage → API → Webhooks.
SANITY_REVALIDATE_SECRET=
